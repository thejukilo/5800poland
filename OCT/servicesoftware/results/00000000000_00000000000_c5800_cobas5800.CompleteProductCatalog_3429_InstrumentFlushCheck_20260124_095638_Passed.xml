    <ds:WorkFlow>
      <ds:Step Name="ConnectInstrument" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The software is connecting to the instrument.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CloseAndLockDoor">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>Close the door so that it can be locked.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="Initialize">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The instrument is being initialized. This can take up to seven minutes.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="BulkReagentsLoadCheck">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>Checking whether the required bulk reagents are loaded.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="LoadBulkReagents" Type="Loop">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Load the required bulk reagents to continue.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="BulkReagentsLoaded">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>All the required bulk reagents are loaded.</base:Paragraph>
              <base:Paragraph>[R.irBulkReagentsLoadedInformation]</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="LoadFilledEmptyBottleKit" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Load the empty bottle kit filled with demineralized water:</base:Paragraph>
              <base:Paragraph>wash reagent container</base:Paragraph>
              <base:Paragraph>diluent container</base:Paragraph>
              <base:Paragraph>lysis 1 container</base:Paragraph>
              <base:Paragraph>lysis 2 container</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainDiluentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The diluent reservoir is being drained into the liquid waste.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainOverflowBottle1">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The overflow container is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="FillDiluentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The diluent reservoir is filled with [P.pInitialPumpVolumeDiluent]ml demineralized water.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="RefillDiluentContainer" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The diluent container has been unlocked.</base:Paragraph>
              <base:Paragraph>Refill the container with demineralized water and press next.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="OverflowDiluentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The software attempts to pump an additional [P.pAdditionalPumpVolumeDiluent] ml of demineralized water into the full diluent reservoir in order to flush the connection to the overflow container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainOverflowBottle2">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The overflow bottle is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="OverflowWashReagentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The software attempts to pump [P.pPumpVolumeWashReagent] ml of demineralized water into the wash reagent reservoir in order to flush the connection to the overflow container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainOverflowBottle3">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The overflow container is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="UnlockCover">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Unlocking the instrument cover.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="FillProcessWaste" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Prepare [P.pManualFillVolumeProcessWaste]ml demineralized water.</base:Paragraph>
              <base:Paragraph>Open the front cover and manually fill demineralized water into the process waste station until some water runs into the overflow. Press next.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainProcessWaste" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The liquid waste station is being drained.</base:Paragraph>
              <base:Paragraph>Fill the rest of the prepared demineralized water into the liquid waste station. Once all water is drained, press next.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="StopDrainProcessWaste">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Close the front cover to continue.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DegasLysis2">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Degassing [P.pDegasVolumeLysis2]ml from position lysis 2 container into liquid waste 1 container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="WashLysis1">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Washing [P.pWashVolumeLysis1InnerHaz]ml from position lysis 1 container into the hazardrous wash station using the reagent transfer head.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="WashDiluent">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Washing [P.pWashVolumeDiluentOuterHaz]ml from the diluent reservoir into the hazardrous wash station using the reagent transfer head.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="WashWashReagent">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Washing [P.pWashVolumeWashReagentOuterNonHaz]ml from the Wash Reagent reservoir into the clean wash station using the reagent transfer Head.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="OverflowWashStation">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The valve (V8 WashStationDrainHighContaminatedValve) connecting the wash station and the liquid waste containers is closed.</base:Paragraph>
              <base:Paragraph>The reagent needles are washed with [P.pOverflowVolumeWashStation] ml wash reagent into the hazardrous wash station. The liquid should flow into the overflow container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainOverflowBottle4">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The overflow container is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainWashStation">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The wash station is being drained into the liquid waste container for [P.pDrainWashStationTime] seconds.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CustomCleanup" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The transfer heads are parked, the drawers, containers and the door are unlocked.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="RemoveBulkReagentContainersAndWaste" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>All bulk reagent positions and liquid waste containers are unlocked.</base:Paragraph>
              <base:Paragraph />
              <base:Paragraph>Remove the empty bottle kit and empty the liquid waste containers.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
    </ds:WorkFlow>
  </ds:TestFunction>
</ds:TestList>