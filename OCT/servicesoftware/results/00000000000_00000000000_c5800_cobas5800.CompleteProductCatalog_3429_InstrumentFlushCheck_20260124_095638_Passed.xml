              <base:Paragraph>All the required bulk reagents were loaded successfully.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value State="Passed">True</data:Value>
          <data:Enum />
        </data:Result>
        <data:Result Name="irBulkReagentsLoadedInformation" Type="String" State="Passed">
          <data:Description>
            <base:Title>Bulk Reagents Loaded Information:</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Contains information about actions that are performed when all the required bulk reagents are loaded.</base:Paragraph>
