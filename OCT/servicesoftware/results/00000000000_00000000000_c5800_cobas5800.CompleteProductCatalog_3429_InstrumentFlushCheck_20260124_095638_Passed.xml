    <ds:Data>
      <data:ParameterList>
        <data:Parameter Name="pRequiredLiquidWasteCapacity1" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Required Liquid Waste Capacity 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The required remaining capacity of liquid waste container 1 to start the check.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>4000</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pRequiredLiquidWasteCapacity2" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Required Liquid Waste Capacity 2</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The required remaining capacity of liquid waste container 2 to start the check.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>4000</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pMaxWaitTimeForOverflowSensor" Type="Integer" Unit="s">
          <data:Description>
            <base:Title>Maximum Wait Time For Overflow Sensor</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum time to wait for the overflow sensor after the internal reservoirs have been overflown.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>60</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pInitialPumpVolumeDiluent" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Initial Pump Volume Diluent</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Initial volume to pump into the diluent reservoir.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>800</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pAdditionalPumpVolumeDiluent" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Additional Pump Volume Diluent</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Additional volume to pump into the already filled diluent reservoir to provoke an overflow.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>800</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pPumpVolumeWashReagent" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Pump Volume Wash Reagent</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Volume to pump into the wash reagent reservoir to provoke an overflow.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>3000</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pManualFillVolumeProcessWaste" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Manual Fill Volume Process Waste</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Distilled water volume to manually pour into the process waste station.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>300</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pDegasVolumeLysis2" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Degas Volume Lysis 2</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The volume to be used for degassing from lysis bottle 2 to liquid waste container 1.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>300</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pWashVolumeLysis1InnerHaz" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Wash Volume Lysis 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wash volume per needle to wash from lysis bottle 1 to hazardous wash station inner position.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>156</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pWashVolumeDiluentOuterHaz" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Wash Volume Diluent</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wash volume per needle to wash from diluent reservoir to hazardous wash station outer position.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>78</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pWashVolumeWashReagentOuterNonHaz" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Wash Volume Wash Reagent</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wash volume per needle to wash from wash reagent reservoir to non hazardous wash station outer position.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>78</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pOverflowVolumeWashStation" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Overflow Volume Wash Station</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wash volume per needle for final overflow of hazardous waste wash station.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>106</data:Value>
          <data:Enum />
        </data:Parameter>
        <data:Parameter Name="pDrainWashStationTime" Type="Integer" Unit="s">
          <data:Description>
            <base:Title>Time to drain the wash stations</base:Title>
            <base:Paragraphs>
              <base:Paragraph>How long to drain the wash stations.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>30</data:Value>
          <data:Enum />
        </data:Parameter>
      </data:ParameterList>
      <data:ResultList>
