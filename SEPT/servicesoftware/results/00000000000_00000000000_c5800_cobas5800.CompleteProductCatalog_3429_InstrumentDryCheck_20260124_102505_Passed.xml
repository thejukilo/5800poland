    <ds:WorkFlow>
      <ds:Step Name="ConnectInstrument" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The software is connecting to the instrument.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CloseAndLockDoor">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>Close the door so that it can be locked.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="Initialize">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The instrument is being initialized. This can take up to seven minutes.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="BulkReagentsLoadCheck">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>Checking whether the required bulk reagents are loaded.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="LoadBulkReagents" Type="Loop">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Load the required bulk reagents to continue.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="BulkReagentsLoaded">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>All the required bulk reagents are loaded.</base:Paragraph>
              <base:Paragraph>[R.irBulkReagentsLoadedInformation]</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="LoadEmptyWasteContainers" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Load two empty liquid waste containers.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryBulkToDiluentReservoirChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryBulkToDiluentReservoirChannelVolume]ml air is pumped to dry the connection from the diluent container position to the diluent reservoir.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryBulkToWashReagentReservoirChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryBulkToWashReagentReservoirChannelVolume]ml air is pumped to dry the connection from the wash reagent container position to the wash reagent reservoir.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainDiluentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The Diluent reservoir is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainWashReagentReservoir">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The Wash reagent reservoir is being drained into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainOverflowBottle">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The overflow container is being drained.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryLysisDegasChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>[P.pDryLysisDegasChannelVolume]ml air is pumped to dry the connection from lysis container 2 position to the liquid waste container 1 (degas connection).</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryLysisChannels">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryLysisChannelsVolume]ml air is pumped per needle from lysis container 1 into the hazardous wash station.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryDiluentChannels">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryDiluentChannelsVolume]ml air is pumped per needle from the diluent reservoir into the hazardous wash station.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryWashReagentChannels">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryWashReagentChannelsVolume]ml air is pumped per needle from the wash reagent reservoir into the hazardous wash station.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DrainLiquidWasteStation">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The liquid waste station is being drained for [P.pDrainLiquidWasteStationTime]s into the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryDiluentReservoirToWasteChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryDiluentReservoirToWasteChannelVolume]ml air is pumped to dry the connection from the diluent reservoir to the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryWashReagentReservoirToWasteChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>[P.pDryWashReagentReservoirToWasteChannelVolume]ml air is pumped to dry the connection from the diluent reservoir to the liquid waste container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="DryOverflowToWasteChannel">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>The overflow container is being drained.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CustomCleanup" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph />
              <base:Paragraph>The transfer heads are parked, the drawers, containers and the door are unlocked.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="RemoveWasteAndEmptyOverflow" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Paragraphs>
              <base:Paragraph>Unload and empty the liquid waste containers</base:Paragraph>
              <base:Paragraph>Manually empty the overflow container.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
    </ds:WorkFlow>
  </ds:TestFunction>
</ds:TestList>