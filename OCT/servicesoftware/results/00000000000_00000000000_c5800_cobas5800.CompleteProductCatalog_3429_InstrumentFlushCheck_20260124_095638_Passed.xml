              <base:Title>Loaded</base:Title>
              <base:Paragraphs>
                <base:Paragraph>The loaded prerequisites</base:Paragraph>
              </base:Paragraphs>
            </data:Description>
            <data:Value State="Passed">Liquid Waste 1 available: 4448ml</data:Value>
            <data:Value State="Passed">Liquid Waste 2 available: 4438ml</data:Value>
            <data:Enum />
          </data:Result>
          <data:Result Name="irPrerequisitesNeeded" Type="String" Array="true" State="Passed">
            <data:Description>
              <base:Title>Needed</base:Title>
              <base:Paragraphs>
                <base:Paragraph>The needed prerequisites</base:Paragraph>
              </base:Paragraphs>
            </data:Description>
            <data:Enum />
          </data:Result>
          <data:Result Name="irPrerequisitesRemove" Type="String" Array="true" State="Passed">
            <data:Description>
              <base:Title>Remove</base:Title>
              <base:Paragraphs>
                <base:Paragraph>The prerequisites to be removed</base:Paragraph>
              </base:Paragraphs>
            </data:Description>
            <data:Enum />
          </data:Result>
          <data:Description>The prerequisites of this check</data:Description>
