        <data:Parameter Name="pDryWashReagentChannelsVolume" Type="Integer" Unit="ml">
          <data:Description>
            <base:Title>Dry Wash Reagent Channels Volume</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The wash volume to dry the wash reagent channels.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>78</data:Value>
